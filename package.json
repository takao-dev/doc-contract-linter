{
  "name": "doc-contract-linter",
  "version": "1.0.0",
  "description": "Zero-dependency Docs-as-Code contract verifier and audience-boundary linter for AI-assisted repositories.",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "bin": {
    "doc-contract-linter": "src/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "README_JA.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', {recursive: true})\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info"
  },
  "keywords": [
    "documentation",
    "linter",
    "contracts",
    "traceability",
    "docs-as-code",
    "security-boundary",
    "ai-guardrails"
  ],
  "author": "takao-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takao-dev/doc-contract-linter.git"
  }
}
